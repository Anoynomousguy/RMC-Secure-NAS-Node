# Copy this file to .env, then replace every placeholder with a strong random value.
# Generate values with: openssl rand -hex 16
# NEVER commit .env. It is excluded by .gitignore.

VAULTWARDEN_ADMIN_TOKEN=your_token_here
FILEBROWSER_ADMIN_PASSWORD=your_password_here

# External HTTPS origin provided by Tailscale Serve. No trailing slash.
VAULTWARDEN_DOMAIN=https://your-tailscale-host.ts.net