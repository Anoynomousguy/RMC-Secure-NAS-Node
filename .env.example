# Vaultwarden: Argon2id PHC hash, not the plaintext admin token.
# Generate with the Vaultwarden image:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Keep the plaintext token in a password manager, never in this file.
VAULTWARDEN_ADMIN_TOKEN='$argon2id$your_hash_here'

# Dufs: operator password (used to log in) and its SHA-512 crypt hash.
# The container receives only the hash; the plaintext is for the human operator.
# Generate:
#   DUFS_ADMIN_PASSWORD="$(openssl rand -hex 16)"
#   DUFS_ADMIN_PASSWORD_HASH="$(openssl passwd -6 "$DUFS_ADMIN_PASSWORD")"
DUFS_ADMIN_PASSWORD=your_password_here
DUFS_ADMIN_PASSWORD_HASH='$6$your_hash_here'

# External HTTPS origin served by Tailscale Serve. No trailing slash.
VAULTWARDEN_DOMAIN=https://your-tailscale-host.ts.net