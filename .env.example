# Vaultwarden: Argon2id PHC hash, not the plaintext admin token.
# Generate with the Vaultwarden image:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Keep the plaintext token in a password manager, never in this file.
VAULTWARDEN_ADMIN_TOKEN='$argon2id$your_hash_here'

# Dufs: operator password (used to log in) and its SHA-512 crypt hash.
# The container receives only the hash; the plaintext is for the human operator.
# Generate:
#   DUFS_ADMIN_PASSWORD="$(openssl rand -hex 16)"
#   DUFS_ADMIN_PASSWORD_HASH="$(openssl passwd -6 "$DUFS_ADMIN_PASSWORD")"
DUFS_ADMIN_PASSWORD=your_password_here
DUFS_ADMIN_PASSWORD_HASH='$6$your_hash_here'

# External HTTPS origin served by Tailscale Serve. No trailing slash.
VAULTWARDEN_DOMAIN=https://your-tailscale-host.ts.net

# Authelia SSO (single sign-on for the Dufs web UI and the web portal).
# Generate secrets with: openssl rand -hex 32
# Generate password hashes with:
#   docker run --rm authelia/authelia:4.39.28 authelia crypto hash generate argon2 --password '<password>'
AUTHELIA_HOSTNAME=your-nas.your-tailnet.ts.net
AUTHELIA_SESSION_SECRET=replace_with_openssl_rand_hex_32
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
AUTHELIA_JWT_SECRET=replace_with_openssl_rand_hex_32
AUTHELIA_ADMIN_PASSWORD=replace_with_a_strong_password
AUTHELIA_ADMIN_PASSWORD_HASH='$argon2id$your_hash_here'
AUTHELIA_USER1_PASSWORD=replace_with_a_strong_password
AUTHELIA_USER1_PASSWORD_HASH='$argon2id$your_hash_here'
AUTHELIA_USER2_PASSWORD=replace_with_a_strong_password
AUTHELIA_USER2_PASSWORD_HASH='$argon2id$your_hash_here'

# base64("admin:<DUFS_ADMIN_PASSWORD>") used by Caddy to inject Basic auth
# upstream after Authelia has authorized the request.
#   printf 'admin:%s' "$DUFS_ADMIN_PASSWORD" | base64 -w0
DUFS_ADMIN_BASIC=replace_with_base64_of_admin_colon_password
